{
  "manifest_version": 3,
  "name": "PiP Plus",
  "version": "1.1.0",
  "description": "Float a video in an always-on-top window, with a minimize button.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Float video (Alt+Shift+V)" },
  "commands": {
    "video-pip": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Float the video on this page"
    }
  }
}
